{
  "entities": {
    "ScoreEntry": {
      "title": "ScoreEntry",
      "description": "A user's predicted ECET score",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the user"
        },
        "score": {
          "type": "number",
          "description": "The predicted score"
        },
        "maxScore": {
          "type": "number",
          "description": "The maximum possible score"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the score was saved"
        },
        "userId": {
          "type": "string",
          "description": "Optional user ID if logged in"
        }
      },
      "required": ["name", "score", "maxScore", "createdAt"]
    },
    "EcetResponse": {
      "title": "EcetResponse",
      "description": "Analyzed ECET response sheet results",
      "type": "object",
      "properties": {
        "candidateName": { "type": "string" },
        "hallTicket": { "type": "string" },
        "subject": { "type": "string" },
        "testDate": { "type": "string" },
        "score": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "correctCount": { "type": "number" },
        "wrongCount": { "type": "number" },
        "skippedCount": { "type": "number" },
        "questions": {
          "type": "array",
          "items": { "type": "object" }
        },
        "uploadedAt": { "type": "object" },
        "uploadedBy": { "type": "string" }
      },
      "required": ["candidateName", "hallTicket", "score", "totalQuestions", "uploadedBy"]
    }
  },
  "firestore": {
    "/ecet_scores/{scoreId}": {
      "schema": {
        "$ref": "#/entities/ScoreEntry"
      },
      "description": "Stores user predicted scores"
    },
    "/ecet_responses/{responseId}": {
      "schema": {
        "$ref": "#/entities/EcetResponse"
      },
      "description": "Analyzed ECET response sheet results"
    }
  }
}
