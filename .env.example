# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# RESEND_API_KEY: Required for sending authentication emails.
# Get this from https://resend.com
RESEND_API_KEY=""

# JWT_SECRET: Secret key for signing JSON Web Tokens
JWT_SECRET="your_super_secret_jwt_key_here"
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VAPID KEYS: Required for Web Push Notifications.
# You can generate these by running `npx web-push generate-vapid-keys` in terminal.
VAPID_PUBLIC_KEY="your_vapid_public_key_here"
VAPID_PRIVATE_KEY="your_vapid_private_key_here"

# BLOB_READ_WRITE_TOKEN: Required for Vercel Blob Storage file uploads
# Get this from your Vercel Dashboard -> Storage -> Blob
BLOB_READ_WRITE_TOKEN=""

# OCR_SPACE_API_KEY: Required for extracting text from PDFs and Images.
OCR_SPACE_API_KEY=""
# PAYU PAYMENT GATEWAY CREDENTIALS:
# Get your Merchant Key and Merchant Salt from your PayU Dashboard: https://onboarding.payu.in
# (Payment Gateway -> Integration Details / API Keys)
PAYU_MERCHANT_KEY=""
# SUPABASE CREDENTIALS:
# Get your Project URL and Anon Key from your Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"

# ADMIN AUTHENTICATION (For PayU Financial Ledger & Control Panel Access):
# Authorized administrator email for receiving single-use encrypted OTPs
ADMIN_EMAIL="syaswanthkumar2006@gmail.com"


